index 0000000..2c04ccf
--- /dev/null
+++ b/crates/db/src/changes.rs
@@ -0,0 +1,271 @@
+//! What each write changed, by scope, so caches drop only what it could affect.
+//!
+//! The response and fragment caches used to be versioned by `PRAGMA data_version`: any commit
+//! anywhere made every cached page and fragment unreachable, so with people posting, almost
+//! every read rendered again. Here SQLite's update hook on the writer connection records each row
+//! a write touched (its table and rowid), and after the write commits (before its caller hears
+//! back) the rows become version bumps:
+//!
+//! - a message (created or changed) or a boost: its room's version;
+//! - the search index: the activity version (search results span rooms);
+//! - a room's `touch` (`belongs_to :room, touch: true`) and its activity counts: the activity
+//!   version (sidebars order and mark rooms by it); nothing a room page shows;
+//! - a membership's read state or connection (`unread_at`, `connected_at`, `connections`): its
+//!   user's version (their sidebar);
+//! - a search's history row: its user's version;
+//! - anything else (a rename, a membership made or ended, a deletion, an unknown table): the
+//!   global version, which every cache key includes: what `data_version` did for every write.
+//!
+//! Which room-row and membership-row writes are "activity" or "read state" is said where those
+//! statements run ([`tagged`]); an untagged write to those tables is global. A rolled back write
+//! may leave rows behind; they only cause extra bumps (a row that's gone is global).
+
+use std::cell::{Cell, RefCell};
+use std::collections::{HashMap, HashSet};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{LazyLock, RwLock};
+
+use rusqlite::hooks::Action;
+use rusqlite::{Connection, OptionalExtension};
+
+/// What a tagged statement's rows change (see the module's list).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Tag {
+    None,
+    /// A room's `updated_at` or activity counts.
+    Activity,
+    /// A membership's read state or connection.
+    ReadState,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Table {
+    Messages,
+    Boosts,
+    RichTexts,
+    SearchIndex,
+    Rooms,
+    Memberships,
+    Searches,
+    Other,
+}
+
+fn table(name: &str) -> Table {
+    match name {
+        "messages" => Table::Messages,
+        "boosts" => Table::Boosts,
+        "action_text_rich_texts" => Table::RichTexts,
+        "rooms" => Table::Rooms,
+        "memberships" => Table::Memberships,
+        "searches" => Table::Searches,
+        n if n.starts_with("message_search_index") => Table::SearchIndex,
+        _ => Table::Other,
+    }
+}
+
+thread_local! {
+    static TAG: Cell<Tag> = const { Cell::new(Tag::None) };
+    static ROWS: RefCell<Vec<(Table, Action, i64, Tag)>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Runs `f` with its statements' rows tagged.
+pub fn tagged<R>(tag: Tag, f: impl FnOnce() -> R) -> R {
+    let before = TAG.replace(tag);
+    let result = f();
+    TAG.set(before);
+    result
+}
+
+/// Tags the statements that run until the guard drops (the rest of a model method).
+pub fn tag(tag: Tag) -> TagGuard {
+    TagGuard(TAG.replace(tag))
+}
+
+pub struct TagGuard(Tag);
+
+impl Drop for TagGuard {
+    fn drop(&mut self) {
+        TAG.set(self.0);
+    }
+}
+
+/// Records the writer connection's row changes (on the writer's thread).
+pub fn record(conn: &Connection) -> rusqlite::Result<()> {
+    conn.update_hook(Some(|action: Action, _db: &str, name: &str, rowid: i64| {
+        let tag = TAG.get();
+        ROWS.with(|rows| rows.borrow_mut().push((table(name), action, rowid, tag)));
+    }))
+}
+
+/// Forgets the rows of a write that rolled back (nothing of it committed).
+pub fn forget() {
+    ROWS.with(|rows| rows.borrow_mut().clear());
+}
+
+/// The versions caches key on.
+#[derive(Default)]
+pub struct Versions {
+    global: AtomicU64,
+    activity: AtomicU64,
+    rooms: RwLock<HashMap<i64, u64>>,
+    users: RwLock<HashMap<i64, u64>>,
+}
+
+/// One process, one database: its versions.
+pub static VERSIONS: LazyLock<Versions> = LazyLock::new(Versions::default);
+
+impl Versions {
+    pub fn global(&self) -> u64 {
+        self.global.load(Ordering::Acquire)
+    }
+    pub fn activity(&self) -> u64 {
+        self.activity.load(Ordering::Acquire)
+    }
+    pub fn room(&self, id: i64) -> u64 {
+        self.rooms.read().unwrap().get(&id).copied().unwrap_or(0)
+    }
+    pub fn user(&self, id: i64) -> u64 {
+        self.users.read().unwrap().get(&id).copied().unwrap_or(0)
+    }
+}
+
+/// Turns the rows written since the last call into version bumps (on the writer's thread, after
+/// a commit). Lookups read the written rows' rooms and users on `conn`.
+pub fn publish(conn: &Connection) {
+    let rows = ROWS.with(|rows| std::mem::take(&mut *rows.borrow_mut()));
+    if rows.is_empty() {
+        return;
+    }
+    let (mut global, mut activity) = (false, false);
+    let (mut rooms, mut users) = (HashSet::new(), HashSet::new());
+    let touched_message = rows.iter().any(|(t, a, _, _)| *t == Table::Messages && *a != Action::SQLITE_DELETE);
+    let one = |sql: &str, id: i64| -> Option<i64> { conn.prepare_cached(sql).ok()?.query_row([id], |r| r.get(0)).optional().ok().flatten() };
+    for (t, action, rowid, tag) in rows {
+        let deleted = action == Action::SQLITE_DELETE;
+        match (t, tag) {
+            (Table::SearchIndex, _) => activity = true,
+            (Table::Messages, _) if !deleted => match one(r#"SELECT "room_id" FROM "messages" WHERE "id" = ?"#, rowid) {
+                Some(room) => {
+                    rooms.insert(room);
+                    activity = true;
+                }
+                None => global = true,
+            },
+            (Table::Boosts, _) if !deleted => {
+                match one(r#"SELECT "messages"."room_id" FROM "boosts" JOIN "messages" ON "messages"."id" = "boosts"."message_id" WHERE "boosts"."id" = ?"#, rowid) {
+                    Some(room) => {
+                        rooms.insert(room);
+                    }
+                    None => global = true,
+                }
+            }
+            // a boost or a message's rich text goes with its message, which the write touched
+            (Table::Boosts | Table::RichTexts, _) if touched_message => {}
+            (Table::Rooms, Tag::Activity) if !deleted => activity = true,
+            (Table::Memberships, Tag::ReadState) if !deleted => match one(r#"SELECT "user_id" FROM "memberships" WHERE "id" = ?"#, rowid) {
+                Some(user) => {
+                    users.insert(user);
+                }
+                None => global = true,
+            },
+            (Table::Searches, _) if !deleted => match one(r#"SELECT "user_id" FROM "searches" WHERE "id" = ?"#, rowid) {
+                Some(user) => {
+                    users.insert(user);
+                }
+                None => global = true,
+            },
+            _ => global = true,
+        }
+    }
+    let v = &*VERSIONS;
+    if !rooms.is_empty() {
+        let mut map = v.rooms.write().unwrap();
+        for room in rooms {
+            *map.entry(room).or_default() += 1;
+        }
+    }
+    if !users.is_empty() {
+        let mut map = v.users.write().unwrap();
+        for user in users {
+            *map.entry(user).or_default() += 1;
+        }
+    }
+    if activity {
+        v.activity.fetch_add(1, Ordering::AcqRel);
+    }
+    if global {
+        v.global.fetch_add(1, Ordering::AcqRel);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    // ids no other test uses: the versions are one per process, and tests run in parallel
+    fn db() -> Connection {
+        let c = Connection::open_in_memory().unwrap();
+        c.execute_batch(
+            r#"CREATE TABLE "rooms" (id INTEGER PRIMARY KEY, name TEXT, updated_at INTEGER);
+               CREATE TABLE "messages" (id INTEGER PRIMARY KEY, room_id INTEGER, updated_at INTEGER);
+               CREATE TABLE "boosts" (id INTEGER PRIMARY KEY, message_id INTEGER);
+               CREATE TABLE "memberships" (id INTEGER PRIMARY KEY, user_id INTEGER, room_id INTEGER, unread_at INTEGER);
+               CREATE TABLE "users" (id INTEGER PRIMARY KEY, name TEXT);
+               INSERT INTO rooms VALUES (9101, 'a', 0), (9102, 'b', 0);
+               INSERT INTO memberships VALUES (9201, 9301, 9101, NULL);"#,
+        )
+        .unwrap();
+        record(&c).unwrap();
+        c
+    }
+
+    #[test]
+    fn a_message_moves_its_room_only() {
+        let c = db();
+        let (a, b, g) = (VERSIONS.room(9101), VERSIONS.room(9102), VERSIONS.global());
+        c.execute("INSERT INTO messages VALUES (9401, 9101, 1)", []).unwrap();
+        c.execute("INSERT INTO boosts VALUES (9501, 9401)", []).unwrap();
+        tagged(Tag::Activity, || c.execute("UPDATE rooms SET updated_at = 2 WHERE id = 9101", [])).unwrap();
+        publish(&c);
+        assert_eq!(VERSIONS.room(9101), a + 1);
+        assert_eq!(VERSIONS.room(9102), b);
+        // nothing here was global (other tests may move it meanwhile, never back)
+        let _ = g;
+    }
+
+    #[test]
+    fn read_state_moves_its_user_and_untagged_writes_are_global() {
+        let c = db();
+        let (u, g) = (VERSIONS.user(9301), VERSIONS.global());
+        tagged(Tag::ReadState, || c.execute("UPDATE memberships SET unread_at = 5 WHERE id = 9201", [])).unwrap();
+        publish(&c);
+        assert_eq!(VERSIONS.user(9301), u + 1);
+        let g1 = VERSIONS.global();
+        assert!(g1 >= g);
+        // the same statement untagged (a membership changed some other way): global
+        c.execute("UPDATE memberships SET unread_at = 6 WHERE id = 9201", []).unwrap();
+        publish(&c);
+        assert!(VERSIONS.global() > g1);
+        // a room renamed (untagged): global
+        let g2 = VERSIONS.global();
+        c.execute("UPDATE rooms SET name = 'c' WHERE id = 9102", []).unwrap();
+        publish(&c);
+        assert!(VERSIONS.global() > g2);
+        // a deletion: global
+        let g3 = VERSIONS.global();
+        c.execute("INSERT INTO messages VALUES (9402, 9102, 1)", []).unwrap();
+        c.execute("DELETE FROM messages WHERE id = 9402", []).unwrap();
+        publish(&c);
+        assert!(VERSIONS.global() > g3);
+    }
+
+    #[test]
+    fn rows_of_a_rolled_back_write_are_forgotten() {
+        let c = db();
+        let a = VERSIONS.room(9102);
+        c.execute("INSERT INTO messages VALUES (9403, 9102, 1)", []).unwrap();
+        forget();
+        publish(&c);
+        assert_eq!(VERSIONS.room(9102), a);
+    }
+}
