diff --git a/crates/db/src/schema.rs b/crates/db/src/schema.rs
index 1fd542e..89e4081 100644
--- a/crates/db/src/schema.rs
+++ b/crates/db/src/schema.rs
@@ -94,9 +94,36 @@ pub fn prepare(conn: &mut Connection, environment: &str, clock: &dyn Clock) -> R
     for addition in ADDITIONS {
         conn.execute_batch(addition)?;
     }
+    add_unread_counts(conn)?;
     Ok(prepared)
 }
 
+/// Unread as counts (`rooms.posts_count`, `memberships.seen_posts`), added to a database that
+/// doesn't have them: every room counts one post, and a member has seen it unless Rails' marked
+/// them unread (`unread_at`), so the same rooms stay unread.
+fn add_unread_counts(conn: &mut Connection) -> Result<()> {
+    let has = |conn: &Connection, table: &str, column: &str| -> Result<bool> {
+        Ok(conn.prepare(&format!("SELECT 1 FROM pragma_table_info('{table}') WHERE name = ?"))?.exists([column])?)
+    };
+    if has(conn, "rooms", "posts_count")? && has(conn, "memberships", "seen_posts")? {
+        return Ok(());
+    }
+    let tx = conn.transaction_with_behavior(rusqlite::TransactionBehavior::Immediate)?;
+    if !has(&tx, "rooms", "posts_count")? {
+        tx.execute_batch(
+            r#"ALTER TABLE "rooms" ADD COLUMN "posts_count" integer DEFAULT 0 NOT NULL; UPDATE "rooms" SET "posts_count" = 1;"#,
+        )?;
+    }
+    if !has(&tx, "memberships", "seen_posts")? {
+        tx.execute_batch(
+            r#"ALTER TABLE "memberships" ADD COLUMN "seen_posts" integer DEFAULT 0 NOT NULL;
+               UPDATE "memberships" SET "seen_posts" = CASE WHEN "unread_at" IS NULL THEN 1 ELSE 0 END;"#,
+        )?;
+    }
+    tx.commit()?;
+    Ok(())
+}
