// Campfire's data (data/campfire is a copy of a Campfire database; etch keeps it as its own).
// Phase 1 covers the room page and posting a message: only the fields those read or write.

config host: Text                        // the address links are made with (start time)
config vapid_public: Text                // the web-push public key (start time)

entity User {
  name: Text
  email: Text? max 254
  password: Password?                    // an argon2id hash; only authenticates() reads it
  bio: Text? max 200
  role: Text                             // "member" | "administrator"
  status: Text                           // "active" | "deactivated"
}

entity Session {
  user: User
  token: Text
}

entity Room {
  type: Text                             // "open" | "closed" | "direct"
  name: Text? max 100
  creator: User?
  posted: Int                            // counts the room's posts: unread is posted > a member's seen
}

entity Membership {
  room: Room
  user: User
  involvement: Text                      // "mentions" | "everything" | "nothing" | "invisible"
  seen: Int                              // the room's posted count when this member last read it
  connected_at: Time?
}

entity Message {
  room: Room
  creator: User
  body: Text max 10000
  client_id: Text
}

entity Boost {
  message: Message
  booster: User
  content: Text max 16
}

entity Account {
  name: Text?
  join_code: Text
  logo: Text?
  restrict_room_creation: Bool
}

// Who is asking: the session cookie's token, through Session, to its user.
viewer User from cookie session_token = Session.token -> .user
