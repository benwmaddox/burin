// Compatibility with crudspec's pages, so the two can be compared byte for byte. These are
// crudspec's implementation details (its handler element ids 88, 137 and 85, and its token
// JSON's shapes), not etch's design; nothing else in the app depends on them.

fn plain_token(r: Room): Text = sign("{\"e\":[],\"p\":" + quote("/rooms/" + text(r.id)) + ",\"v\":[]}")
fn edit_token(m: Message): Text =
  sign("{\"e\":[137],\"p\":\"/rooms/" + text(m.room.id) + "\",\"v\":[[\"m\",{\"ref\":\"Message\",\"id\":" + text(m.id) + "}]]}")
fn composer_token(r: Room): Text =
  sign("{\"e\":[88],\"p\":" + quote("/rooms/" + text(r.id)) + ",\"v\":[[\"room\",{\"ref\":\"Room\",\"id\":" + text(r.id) + "}]]}")
fn picker_token(r: Room): Text = sign("{\"e\":85,\"v\":[[\"room\",{\"id\":" + text(r.id) + ",\"ref\":\"Room\"}]]}")

// crudspec stores an order column (f__seq) beside each optional time; set with it
const storage = "crudspec"
