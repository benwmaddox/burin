// A message board: the second etch app, to check the compiler and runtime aren't Campfire's.
// Its database is its own (etch creates the tables).

config host: Text

entity User {
  name: Text max 60
}

entity Session {
  user: User
  token: Text max 64
}

entity Board {
  title: Text max 80
}

entity Member {
  board: Board
  user: User
}

entity Post {
  board: Board
  author: User
  text: Text max 500
}

viewer User from cookie sid = Session.token -> .user

fn member(u: User, b: Board): Bool = exists(Member where .board == b and .user == u)

// The board's newest posts, newest first.
view recent(b: Board) = Post where .board == b order by .created desc, .seq desc limit 20

// The viewer's own posts, anywhere.
view mine() = Post where .author == viewer order by .created desc limit 5

screen board(board: Board) at "/boards/{board}"
  require member(viewer, board) else go "/"
<<<{{top(board)}}{{for p in recent(board)}}{{post(p)}}{{end}}{{me()}}{{form(board)}}{{bottom()}}>>>

fragment top(board: Board) <<<\
<!doctype html><html><head><meta charset="utf-8"><title>{{board.title}}</title></head>
<body><h1>{{board.title}}</h1><ol class="posts">>>>

fragment post(p: Post) varies by viewer <<<\
<li class="post{{if p.author == viewer}} mine{{end}}" id="post-{{p.id}}"><b>{{p.author.name}}</b> \
<span>{{p.text}}</span> <time datetime="{{iso(p.created)}}">{{clock(p.created)}}</time></li>
>>>

// per viewer: who's signed in, and their latest posts
fragment me() per viewer <<<\
</ol><aside><p>Signed in as <b>{{viewer.name}}</b></p><ul class="mine">\
{{for p in mine()}}<li><a href="/boards/{{p.board.id}}#post-{{p.id}}">{{p.text}}</a></li>{{end}}</ul></aside>
>>>

fragment form(board: Board) <<<\
<form method="post" action="/_do/add_post"><input type="hidden" name="board" value="{{board.id}}">\
<textarea name="text" maxlength="500"></textarea><button>Post</button></form>
>>>

fragment bottom() <<<</body></html>
>>>

// Posts to a board the viewer is a member of.
action add_post(board: Board, text: Text) {
  require member(viewer, board) else not_found
  require present(text) else invalid
  create Post { board: board, author: viewer, text: text }
}

// Joins a board (anyone signed in, for now).
action join(board: Board) {
  require not member(viewer, board) else invalid
  create Member { board: board, user: viewer }
}

// Leaves a board.
action leave(board: Board) {
  require member(viewer, board) else not_found
  for each mb in Member where .board == board and .user == viewer { delete mb }
}
